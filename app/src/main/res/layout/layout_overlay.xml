<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/subtitle_background">
<ImageButton android:id="@+id/btnTranslate" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:src="@drawable/overlay_search" android:tint="#BDEBFF" android:contentDescription="Dịch ngay; giữ để đổi văn phong"/><ImageButton android:id="@+id/btnAuto" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:src="@drawable/overlay_play" android:tint="#BDEBFF" android:contentDescription="Tự động dịch"/><ImageButton android:id="@+id/btnRegion" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:src="@drawable/overlay_crop" android:tint="#BDEBFF" android:contentDescription="Đổi vùng OCR"/><ImageButton android:id="@+id/btnHistory" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:src="@drawable/overlay_history" android:tint="#BDEBFF" android:contentDescription="Lịch sử"/><ImageButton android:id="@+id/btnHide" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:src="@drawable/overlay_eye" android:tint="#BDEBFF" android:contentDescription="Ẩn hoặc hiện phụ đề"/><ImageButton android:id="@+id/btnClose" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:src="@drawable/overlay_close" android:tint="#BDEBFF" android:contentDescription="Dừng dịch"/>
</LinearLayout>
<TextView android:id="@+id/tvSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/subtitle_background" android:padding="14dp" android:textColor="#FFFFFF" android:textSize="18sp" android:lineSpacingExtra="3dp" android:shadowColor="#AA000000" android:shadowRadius="2" android:text="Chạm nút dịch để bắt đầu" />
</LinearLayout>